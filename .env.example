# Copy to .env and choose strong, distinct alphanumeric passwords before deployment.
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
SITE_URL=http://localhost:8032
# Stripe monthly subscription price. Leave blank to launch free tiers only.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Configure SMTP to enable password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
